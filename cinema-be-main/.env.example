# Server
PORT=5000
NODE_ENV=development

# Database
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/cinema-booking?retryWrites=true&w=majority&appName=Cluster0

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRE=7d

# Cookie
COOKIE_SECRET=your-cookie-secret-change-in-production

# Client (CORS — comma-separated origins)
CLIENT_URL=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,https://www.brand-cinemas.online,https://brand-cinemas.online

# Frontend URL for e-ticket QR, email links, and payment redirects
APP_URL=https://www.brand-cinemas.online

# Public API URL for proxied media links
API_URL=https://api.brand-cinemas.online

# Brevo (transactional email) — sender MUST be verified in Brevo dashboard
BREVO_API_KEY=your-brevo-api-key
BREVO_SENDER_EMAIL=your-verified-sender@gmail.com
BREVO_SENDER_NAME=Brand Cinemas

# Chatbot (Google Gemini) — required for POST /api/chat
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-flash-lite-latest
